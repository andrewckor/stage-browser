{
  "name": "stage-browser",
  "productName": "Stage",
  "version": "0.4.2",
  "description": "A minimal Chromium browser for demos, workshops and webinars: edge to edge page, hidden tabs.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/ui/*.html src/ui/*.css dist/ui/ && node scripts/write-runtime.mjs && chmod +x dist/bin/stage.js",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "prepare": "npm run build",
    "start": "npm run build && electron .",
    "selftest": "npm run build && STAGE_SELFTEST=1 electron .",
    "ui:preview": "npm run build && node scripts/ui-preview.mts",
    "cli:install": "sh scripts/install-cli.sh",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@sigstore/bundle": "5.0.1",
    "@sigstore/tuf": "5.0.1",
    "@sigstore/verify": "4.1.3",
    "electron-chrome-extensions": "^4.10.0"
  },
  "bin": {
    "stage": "dist/bin/stage.js"
  },
  "files": [
    "dist/",
    "!dist/main/selftest.js",
    "!dist/ui/mock.js",
    "build/icon.png",
    "build/icon.icns",
    "README.md"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "browser",
    "electron",
    "chromium",
    "screen-sharing",
    "presentation",
    "demo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewckor/stage-browser.git"
  },
  "homepage": "https://stagebrowser.com",
  "bugs": {
    "url": "https://github.com/andrewckor/stage-browser/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.4.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "bundleDependencies": [
    "@sigstore/bundle",
    "@sigstore/tuf",
    "@sigstore/verify",
    "electron-chrome-extensions"
  ]
}
