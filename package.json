{
  "name": "stage-browser",
  "productName": "Stage",
  "version": "0.1.0",
  "description": "A minimal Chromium browser for screen sharing: the page fills the window, tabs hide until you reach for them.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/ui/*.html src/ui/*.css dist/ui/ && chmod +x dist/bin/stage.js",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "prepare": "npm run build",
    "start": "npm run build && electron .",
    "selftest": "npm run build && STAGE_SELFTEST=1 electron .",
    "ui:preview": "npm run build && node scripts/ui-preview.mts",
    "cli:install": "sh scripts/install-cli.sh",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "electron": "^45.4.1",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "bin": {
    "stage": "dist/bin/stage.js"
  },
  "files": [
    "dist/",
    "build/icon.png",
    "build/icon.icns",
    "README.md"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "browser",
    "electron",
    "chromium",
    "screen-sharing",
    "presentation",
    "demo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewckor/stage-browser.git"
  },
  "homepage": "https://github.com/andrewckor/stage-browser#readme",
  "bugs": {
    "url": "https://github.com/andrewckor/stage-browser/issues"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  }
}
